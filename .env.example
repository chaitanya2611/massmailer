# Copy this file to .env and fill in real values before running the app
# for real use. Local `manage.py runserver` works with none of these set
# (SQLite + insecure dev key + OAuth "not configured" messages).

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Managed Postgres connection string (Supabase/Neon/etc). Leave unset to use
# local SQLite.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required before any Gmail/Outlook account is connected (encrypts stored
# OAuth tokens at rest).
FIELD_ENCRYPTION_KEY=

# Google Cloud Console -> APIs & Services -> Credentials (OAuth client ID,
# type "Web application"). Redirect URI: {your domain}/sending-accounts/callback/google/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Azure Portal -> App registrations. Redirect URI:
# {your domain}/sending-accounts/callback/microsoft/
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

MAX_UPLOAD_SIZE_BYTES=10485760
GMAIL_DAILY_SEND_LIMIT=450
MS365_DAILY_SEND_LIMIT=450
